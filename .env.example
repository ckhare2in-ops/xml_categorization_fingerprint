# Copy this file to .env and fill in your keys.

# Required: OpenAI (chat + embeddings).
OPENAI_API_KEY=sk-...

# Optional: Langfuse tracing. Without these the pipeline runs normally and
# tracing is simply skipped.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # LANGFUSE_HOST is also accepted
